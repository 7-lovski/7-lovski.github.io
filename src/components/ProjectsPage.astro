---
import { getCollection } from 'astro:content';
import Footer from './Footer.astro';
import Header from './Header.astro';
import LocalizedText from './LocalizedText.astro';
import RevealMotion from './RevealMotion.astro';
import {projectsContent} from '../data/siteContent';
import { getContentPath, type Locale } from '../utils/i18n';
import { getLocalizedField } from '../utils/content';
import { normalizeRepositoryUrl } from '../utils/projects';

interface Props {
    locale: Locale;
}

const {locale} = Astro.props;
const projectDetailSlugs = new Set((await getCollection('projects')).map((entry) => entry.id));
const detailLinkText = {
	zh: '查看详情',
	en: 'View Case Study',
};
const repositoryLinkText = {
	zh: 'Git 仓库',
	en: 'GitHub',
};
---

<Header/>

<main>
    <section class="page-hero reveal" style="--reveal-delay: 40ms">
        <LocalizedText locale={locale} text={projectsContent.title} tag="h1"/>
        <LocalizedText locale={locale} text={projectsContent.description} tag="p" class="section-copy"/>
    </section>

    <section class="projects-grid card">
        {
            projectsContent.items.map((item, index) => {
                const href =
                    item.slug && projectDetailSlugs.has(item.slug)
                        ? getContentPath('projects', item.slug, locale)
                        : null;

                return (
                    <article class="card project-card reveal" style={`--reveal-delay: ${90 + index * 65}ms`}>
                        <div class="project-card-content">
                            <div class="project-card-heading">
                                {
                                    href ? (
                                        <a class="project-title-link" href={href}>
                                            <LocalizedText locale={locale} text={item.title} tag="h2" class="project-card-title"/>
                                        </a>
                                    ) : (
                                        <LocalizedText locale={locale} text={item.title} tag="h2" class="project-card-title"/>
                                    )
                                }
                                {
                                    item.status && (
                                        <LocalizedText locale={locale} text={item.status} tag="p" class="project-status-chip"/>
                                    )
                                }
                                <LocalizedText locale={locale} text={item.description} tag="p" class="project-card-description"/>
                                {
                                    item.role && (
                                        <LocalizedText locale={locale} text={item.role} tag="p" class="project-card-role"/>
                                    )
                                }
                            </div>
                            <div class="pill-row project-tag-row">
                                {
                                    item.tags.map((tag) => {
                                        const label =
                                            locale === 'bi'
                                                ? tag.zh === tag.en
                                                    ? tag.zh
                                                    : `${tag.zh} / ${tag.en}`
                                                : locale === 'zh'
                                                    ? tag.zh
                                                    : tag.en;

                                        return <span class="pill">{label}</span>;
                                    })
                                }
                            </div>
                        </div>

                        {
                            (href || item.repositoryUrl) && (
                                <div class="project-actions">
                                    {
                                        href && (
                                            <a class="detail-link" href={href}>
                                                <LocalizedText locale={locale} text={detailLinkText} tag="span" />
                                            </a>
                                        )
                                    }
                                    {
                                        item.repositoryUrl && (
                                            <a
                                                class="repo-link"
                                                href={normalizeRepositoryUrl(item.repositoryUrl)}
                                                target="_blank"
                                                rel="noreferrer"
                                                aria-label={locale === 'zh' ? 'Git 仓库' : 'GitHub Repository'}
                                            >
                                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                                    <path
                                                        fill="currentColor"
                                                        d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.37-2.22-.26-4.56-1.14-4.56-5.08 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.84a9.3 9.3 0 0 1 2.5.35c1.9-1.32 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.95-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.26 10.26 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"
                                                    />
                                                </svg>
                                                <span>{locale === 'bi' ? 'GitHub' : getLocalizedField(repositoryLinkText, locale)}</span>
                                            </a>
                                        )
                                    }
                                </div>
                            )
                        }
                    </article>
                );
            })
        }
    </section>
</main>

<Footer locale={locale}/>
<RevealMotion />

<style>
    .page-hero {
        margin-top: 1rem;
    }

    .projects-grid {
        margin-top: 2rem;
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1rem;
        padding: clamp(1rem, 2vw, 1.5rem);
    }

    .project-card {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        padding: clamp(1.2rem, 2.5vw, 1.65rem);
        border: 1px solid rgba(35, 68, 110, 0.1);
        background:
            linear-gradient(135deg, rgba(53, 92, 154, 0.06), rgba(255, 255, 255, 0) 42%),
            rgba(255, 255, 255, 0.9);
        box-shadow: 0 10px 28px rgba(35, 68, 110, 0.07);
        transition:
            opacity 0.6s var(--motion-ease) var(--reveal-delay, 0ms),
            transform 0.6s var(--motion-ease) var(--reveal-delay, 0ms),
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background-color 0.2s ease;
    }

    .project-card::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 0.25rem;
        background: linear-gradient(180deg, var(--accent), var(--accent-dark));
        opacity: 0.62;
    }

    .project-card:hover,
    .project-card:focus-within {
        transform: translateY(-2px);
        border-color: rgba(53, 92, 154, 0.34);
        box-shadow: 0 18px 34px rgba(35, 68, 110, 0.12);
    }

    .project-card-content {
        display: grid;
        gap: 1rem;
        min-width: 0;
    }

    .project-card-heading {
        display: grid;
        gap: 0.7rem;
        min-width: 0;
    }

    .project-card p {
        margin: 0;
        color: rgb(var(--gray));
    }

    :global(.project-card-description) {
        max-width: 68ch;
        font-size: 0.95rem;
        line-height: 1.72;
    }

    :global(.project-card-title) {
        margin: 0;
        overflow-wrap: anywhere;
        font-size: clamp(1.28rem, 2vw, 1.65rem);
        line-height: 1.2;
        letter-spacing: 0;
    }

    :global(.project-card-title .locale-en) {
        font-size: 0.8em;
        line-height: 1.14;
    }

    .project-title-link {
        color: inherit;
        text-decoration: none;
        text-underline-offset: 0.18em;
        transition: color 0.18s ease;
    }

    .project-title-link:hover {
        color: var(--accent-dark);
    }

    .project-title-link:focus-visible,
    .detail-link:focus-visible,
    .repo-link:focus-visible {
        outline: 2px solid rgba(53, 92, 154, 0.55);
        outline-offset: 0.18rem;
        border-radius: 0.35rem;
    }

    .project-tag-row {
        gap: 0.45rem;
    }

    :global(.project-status-chip) {
        width: fit-content;
        margin: 0;
        padding: 0.26rem 0.55rem;
        border-radius: 999px;
        background: rgba(53, 92, 154, 0.08);
        color: var(--accent-dark);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.04em;
    }

    :global(.project-status-chip .locale-en) {
        font-size: 0.88em;
        opacity: 0.82;
    }

    :global(.project-card-role) {
        max-width: 72ch;
        margin: 0;
        color: rgb(var(--gray-dark));
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1.48;
    }

    :global(.project-card-role .locale-en) {
        display: block;
        margin-top: 0.16rem;
        color: rgb(var(--gray));
        font-size: 0.88em;
        font-weight: 600;
    }

    .project-actions {
        margin-top: auto;
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.9rem;
        border-top: 1px solid rgba(35, 68, 110, 0.08);
    }

    .detail-link {
        display: inline-flex;
        align-items: center;
        min-height: 2rem;
        color: var(--accent-dark);
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
        transition: color 0.18s ease, transform 0.18s ease;
    }

    .detail-link:hover {
        color: var(--accent);
        transform: translateX(2px);
    }

    .repo-link {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 2rem;
        padding: 0.35rem 0.65rem;
        border: 1px solid rgba(35, 68, 110, 0.12);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.72);
        color: rgb(var(--gray-dark));
        font-size: 0.84rem;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition:
            background-color 0.18s ease,
            border-color 0.18s ease,
            color 0.18s ease,
            transform 0.18s ease;
    }

    .repo-link:hover {
        border-color: rgba(53, 92, 154, 0.26);
        background: rgba(53, 92, 154, 0.08);
        color: var(--accent-dark);
        transform: translateY(-1px);
    }

    .repo-link svg {
        width: 1rem;
        height: 1rem;
        flex: 0 0 auto;
    }

    @media (max-width: 560px) {
        .project-card {
            gap: 1rem;
        }

        .project-actions {
            justify-content: flex-start;
        }

        .repo-link {
            max-width: 100%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-card,
        .project-title-link,
        .detail-link,
        .repo-link {
            transition: none;
        }

        .project-card:hover,
        .project-card:focus-within,
        .detail-link:hover,
        .repo-link:hover {
            transform: none;
        }
    }
</style>
