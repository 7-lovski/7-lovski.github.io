---
import { getCollection } from 'astro:content';
import Footer from './Footer.astro';
import Header from './Header.astro';
import LocalizedText from './LocalizedText.astro';
import RevealMotion from './RevealMotion.astro';
import {projectsContent} from '../data/siteContent';
import { getContentPath, type Locale } from '../utils/i18n';
import { getLocalizedField } from '../utils/content';
import { normalizeRepositoryUrl } from '../utils/projects';
import { getProjectCoverSrc } from '../utils/projectMedia';

interface Props {
    locale: Locale;
}

const {locale} = Astro.props;
const projectDetailSlugs = new Set((await getCollection('projects')).map((entry) => entry.id));
const repositoryLinkText = {
	zh: 'Git 仓库',
	en: 'GitHub',
};

function getProjectVisualLabel(item: { tags: { zh: string; en: string }[] }) {
    return item.tags[0]?.zh ?? item.tags[0]?.en ?? 'Project';
}
---

<Header/>

<main>
    <section class="page-hero reveal" style="--reveal-delay: 40ms">
        <LocalizedText locale={locale} text={projectsContent.title} tag="h1"/>
        <LocalizedText locale={locale} text={projectsContent.description} tag="p" class="section-copy"/>
    </section>

    <section class="project-filters reveal" aria-label={locale === 'en' ? 'Project categories' : '项目分类'} style="--reveal-delay: 70ms">
        {
            projectsContent.filters.map((filter) => (
                <button
                    type="button"
                    class:list={['project-filter-button', filter.id === 'all' && 'is-active']}
                    data-project-filter={filter.id}
                    aria-pressed={filter.id === 'all' ? 'true' : 'false'}
                >
                    {getLocalizedField(filter.label, locale)}
                </button>
            ))
        }
    </section>

    <section class="projects-grid card">
        {
            projectsContent.items.map((item, index) => {
                const href =
                    item.slug && projectDetailSlugs.has(item.slug)
                        ? getContentPath('projects', item.slug, locale)
                        : null;
                const coverSrc = getProjectCoverSrc(item.slug);

                return (
                    <article
                        class="card project-card reveal"
                        data-project-card
                        data-project-categories={item.categories.join(' ')}
                        style={`--reveal-delay: ${90 + index * 65}ms`}
                    >
                        {
                            href && (
                                <a
                                    class="project-card-overlay"
                                    href={href}
                                    aria-label={`${locale === 'en' ? 'View case study:' : '查看项目详情：'} ${getLocalizedField(item.title, locale)}`}
                                />
                            )
                        }
                        <div
                            class:list={['project-visual', coverSrc && 'has-cover']}
                            style={coverSrc ? `background-image: linear-gradient(180deg, rgba(20, 32, 48, 0.02), rgba(20, 32, 48, 0.34)), url("${coverSrc}");` : undefined}
                            aria-hidden="true"
                        >
                            <span>{getProjectVisualLabel(item)}</span>
                        </div>
                        <div class="project-card-content">
                            <div class="project-card-heading">
                                {
                                    href ? (
                                        <a class="project-title-link" href={href}>
                                            <LocalizedText locale={locale} text={item.title} tag="h2" class="project-card-title"/>
                                        </a>
                                    ) : (
                                        <LocalizedText locale={locale} text={item.title} tag="h2" class="project-card-title"/>
                                    )
                                }
                                {
                                    item.status && (
                                        <LocalizedText locale={locale} text={item.status} tag="p" class="project-status-chip"/>
                                    )
                                }
                                <LocalizedText locale={locale} text={item.description} tag="p" class="project-card-description"/>
                                {
                                    item.role && (
                                        <LocalizedText locale={locale} text={item.role} tag="p" class="project-card-role"/>
                                    )
                                }
                            </div>
                            <div class="pill-row project-tag-row">
                                {
                                    item.tags.map((tag) => {
                                        const label =
                                            locale === 'bi'
                                                ? tag.zh === tag.en
                                                    ? tag.zh
                                                    : `${tag.zh} / ${tag.en}`
                                                : locale === 'zh'
                                                    ? tag.zh
                                                    : tag.en;

                                        return <span class="pill">{label}</span>;
                                    })
                                }
                            </div>
                        </div>

                        {
                            item.repositoryUrl && (
                                <div class="project-actions">
                                    {
                                        item.repositoryUrl && (
                                            <a
                                                class="repo-link"
                                                href={normalizeRepositoryUrl(item.repositoryUrl)}
                                                target="_blank"
                                                rel="noreferrer"
                                                aria-label={locale === 'zh' ? 'Git 仓库' : 'GitHub Repository'}
                                            >
                                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                                    <path
                                                        fill="currentColor"
                                                        d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.37-2.22-.26-4.56-1.14-4.56-5.08 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.84a9.3 9.3 0 0 1 2.5.35c1.9-1.32 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.95-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.26 10.26 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"
                                                    />
                                                </svg>
                                                <span>{locale === 'bi' ? 'GitHub' : getLocalizedField(repositoryLinkText, locale)}</span>
                                            </a>
                                        )
                                    }
                                </div>
                            )
                        }
                    </article>
                );
            })
        }
        <p class="project-empty-state" data-project-empty hidden>
            {locale === 'en' ? 'No projects in this category yet.' : '该分类下暂无项目'}
        </p>
    </section>
</main>

<Footer locale={locale}/>
<RevealMotion />

<script>
    const filterButtons = Array.from(document.querySelectorAll('[data-project-filter]'));
    const projectCards = Array.from(document.querySelectorAll('[data-project-card]'));
    const emptyState = document.querySelector('[data-project-empty]');
    const projectsGrid = document.querySelector('.projects-grid');
    let filterAnimationTimeout = 0;

    /** Returns whether a project card belongs to the selected filter. */
    function cardMatchesFilter(card, selectedFilter) {
        const categories = (card.getAttribute('data-project-categories') ?? '').split(/\s+/);
        return selectedFilter === 'all' || categories.includes(selectedFilter);
    }

    /** Applies the selected filter after the current cards have had time to fade out. */
    function applyProjectFilter(selectedFilter) {
        let visibleCount = 0;

        projectCards.forEach((card) => {
            const shouldShow = cardMatchesFilter(card, selectedFilter);
            card.toggleAttribute('hidden', !shouldShow);

            if (shouldShow) {
                card.setAttribute('style', `--reveal-delay: ${90 + visibleCount * 65}ms`);
                visibleCount += 1;
            }
        });

        emptyState?.toggleAttribute('hidden', visibleCount > 0);
        projectsGrid?.classList.remove('is-filtering');

        requestAnimationFrame(() => {
            projectCards
                .filter((card) => !card.hasAttribute('hidden'))
                .forEach((card) => card.classList.add('is-visible'));
        });
    }

    /** Replays the project-card reveal sequence so category changes feel like a deliberate transition. */
    function transitionProjectFilter(selectedFilter) {
        window.clearTimeout(filterAnimationTimeout);
        projectsGrid?.classList.add('is-filtering');
        projectCards.forEach((card) => card.classList.remove('is-visible'));

        filterAnimationTimeout = window.setTimeout(() => {
            applyProjectFilter(selectedFilter);
        }, 150);
    }

    /** Syncs the selected filter button state before the card transition starts. */
    function activateFilterButton(activeButton) {
        filterButtons.forEach((entry) => {
            const isActive = entry === activeButton;
            entry.classList.toggle('is-active', isActive);
            entry.setAttribute('aria-pressed', String(isActive));
        });
    }

    filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
            const selectedFilter = button.getAttribute('data-project-filter') ?? 'all';

            activateFilterButton(button);
            transitionProjectFilter(selectedFilter);
        });
    });
</script>

<style>
    .page-hero {
        margin-top: 1rem;
    }

    .project-filters {
        margin-top: 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
        align-items: center;
    }

    :global(button[data-project-filter]) {
        appearance: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.35rem;
        padding: 0.5rem 0.82rem;
        border: 1px solid rgba(35, 68, 110, 0.22);
        border-radius: 999px;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(230, 239, 250, 0.9));
        color: var(--accent-dark);
        box-shadow:
            0 1px 0 rgba(255, 255, 255, 0.86) inset,
            0 8px 18px rgba(31, 61, 109, 0.1);
        font-family: inherit;
        font-size: 0.84rem;
        font-weight: 800;
        line-height: 1;
        cursor: pointer;
        transition:
            background-color 0.18s ease,
            border-color 0.18s ease,
            color 0.18s ease,
            transform 0.18s ease,
            box-shadow 0.18s ease;
    }

    :global(button[data-project-filter]:hover),
    :global(button[data-project-filter]:focus-visible) {
        border-color: rgba(53, 92, 154, 0.42);
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 1), rgba(220, 233, 249, 0.96));
        color: var(--accent-dark);
        transform: translateY(-1px);
        box-shadow:
            0 1px 0 rgba(255, 255, 255, 0.92) inset,
            0 12px 24px rgba(31, 61, 109, 0.14);
    }

    :global(button[data-project-filter]:focus-visible) {
        outline: 2px solid rgba(53, 92, 154, 0.45);
        outline-offset: 0.16rem;
    }

    :global(button[data-project-filter].is-active) {
        border-color: rgba(31, 61, 109, 0.74);
        background: linear-gradient(180deg, var(--accent), var(--accent-dark));
        color: #fff;
        box-shadow: 0 12px 24px rgba(31, 61, 109, 0.18);
    }

    .projects-grid {
        margin-top: 2rem;
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1rem;
        padding: clamp(1rem, 2vw, 1.5rem);
    }

    .projects-grid.is-filtering {
        pointer-events: none;
    }

    .project-card {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: row;
        gap: 1.25rem;
        padding: clamp(1.2rem, 2.5vw, 1.65rem);
        border: 1px solid rgba(35, 68, 110, 0.1);
        background:
            linear-gradient(135deg, rgba(53, 92, 154, 0.06), rgba(255, 255, 255, 0) 42%),
            rgba(255, 255, 255, 0.9);
        box-shadow: 0 10px 28px rgba(35, 68, 110, 0.07);
        transition:
            opacity 0.48s var(--motion-ease) var(--reveal-delay, 0ms),
            transform 0.48s var(--motion-ease) var(--reveal-delay, 0ms),
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background-color 0.2s ease;
    }

    .project-card[hidden] {
        display: none;
    }

    .project-card-overlay {
        position: absolute;
        inset: 0;
        z-index: 3;
        border-radius: inherit;
    }

    .project-card::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 0.25rem;
        background: linear-gradient(180deg, var(--accent), var(--accent-dark));
        opacity: 0.62;
    }

    .project-visual {
        position: relative;
        z-index: 2;
        flex: 0 0 min(32%, 18rem);
        min-height: 13rem;
        display: grid;
        place-items: end start;
        padding: 1rem;
        overflow: hidden;
        border: 1px solid rgba(53, 92, 154, 0.12);
        border-radius: 18px;
        background:
            linear-gradient(135deg, rgba(53, 92, 154, 0.17), transparent 42%),
            radial-gradient(circle at 72% 20%, rgba(120, 154, 198, 0.32), transparent 36%),
            rgba(232, 240, 251, 0.72);
        background-position: center;
        background-size: cover;
    }

    .project-visual::before {
        content: "";
        position: absolute;
        inset: 1rem;
        border-radius: 14px;
        background:
            linear-gradient(90deg, rgba(255, 255, 255, 0.52) 1px, transparent 1px),
            linear-gradient(0deg, rgba(255, 255, 255, 0.52) 1px, transparent 1px);
        background-size: 22px 22px;
    }

    .project-visual.has-cover::before {
        inset: 0;
        border-radius: 0;
        background: linear-gradient(180deg, rgba(8, 16, 28, 0), rgba(8, 16, 28, 0.42));
    }

    .project-visual span {
        position: relative;
        z-index: 1;
        padding: 0.42rem 0.7rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.84);
        color: var(--accent-dark);
        font-size: 0.82rem;
        font-weight: 800;
    }

    .project-visual.has-cover span {
        background: rgba(10, 18, 30, 0.68);
        color: #fff;
    }

    .project-card:hover,
    .project-card:focus-within {
        transform: translate3d(var(--magnetic-x, 0), calc(var(--magnetic-y, 0) - 2px), 0);
        border-color: rgba(53, 92, 154, 0.34);
        box-shadow: 0 18px 34px rgba(35, 68, 110, 0.12);
    }

    .project-card-content {
        position: relative;
        z-index: 2;
        display: grid;
        gap: 1rem;
        min-width: 0;
        flex: 1 1 auto;
    }

    .project-card-heading {
        display: grid;
        gap: 0.7rem;
        min-width: 0;
    }

    .project-card p {
        margin: 0;
        color: rgb(var(--gray));
    }

    :global(.project-card-description) {
        max-width: 68ch;
        font-size: 0.95rem;
        line-height: 1.72;
    }

    :global(.project-card-title) {
        margin: 0;
        overflow-wrap: anywhere;
        font-size: clamp(1.28rem, 2vw, 1.65rem);
        line-height: 1.2;
        letter-spacing: 0;
    }

    :global(.project-card-title .locale-en) {
        font-size: 0.8em;
        line-height: 1.14;
    }

    .project-title-link {
        position: relative;
        z-index: 4;
        color: inherit;
        text-decoration: none;
        text-underline-offset: 0.18em;
        transition: color 0.18s ease;
    }

    .project-title-link:hover {
        color: var(--accent-dark);
    }

    .project-title-link:focus-visible,
    .project-card-overlay:focus-visible,
    .repo-link:focus-visible {
        outline: 2px solid rgba(53, 92, 154, 0.55);
        outline-offset: 0.18rem;
        border-radius: 0.35rem;
    }

    .project-tag-row {
        gap: 0.45rem;
    }

    :global(.project-tag-row .pill) {
        box-sizing: border-box;
        height: 2.25rem;
        padding: 0 0.78rem;
        align-items: center;
        line-height: 1;
        white-space: nowrap;
    }

    :global(.project-status-chip) {
        width: fit-content;
        margin: 0;
        padding: 0.26rem 0.55rem;
        border-radius: 999px;
        background: rgba(53, 92, 154, 0.08);
        color: var(--accent-dark);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.04em;
    }

    :global(.project-status-chip .locale-en) {
        font-size: 0.88em;
        opacity: 0.82;
    }

    :global(.project-card-role) {
        max-width: 72ch;
        margin: 0;
        color: rgb(var(--gray-dark));
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1.48;
    }

    :global(.project-card-role .locale-en) {
        display: block;
        margin-top: 0.16rem;
        color: rgb(var(--gray));
        font-size: 0.88em;
        font-weight: 600;
    }

    .project-actions {
        position: relative;
        z-index: 5;
        margin-top: auto;
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
        align-items: center;
        justify-content: flex-end;
        padding-top: 0.9rem;
        border-top: 1px solid rgba(35, 68, 110, 0.08);
    }

    .repo-link {
        position: relative;
        z-index: 4;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 2rem;
        padding: 0.35rem 0.65rem;
        border: 1px solid rgba(35, 68, 110, 0.12);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.72);
        color: rgb(var(--gray-dark));
        font-size: 0.84rem;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition:
            background-color 0.18s ease,
            border-color 0.18s ease,
            color 0.18s ease,
            transform 0.18s ease;
    }

    .repo-link:hover {
        border-color: rgba(53, 92, 154, 0.26);
        background: rgba(53, 92, 154, 0.08);
        color: var(--accent-dark);
        transform: translate3d(var(--magnetic-x, 0), calc(var(--magnetic-y, 0) - 1px), 0);
    }

    .repo-link svg {
        width: 1rem;
        height: 1rem;
        flex: 0 0 auto;
    }

    @media (max-width: 560px) {
        .project-card {
            flex-direction: column;
            gap: 1rem;
        }

        .project-visual {
            flex-basis: auto;
            min-height: 10rem;
        }

        .project-actions {
            justify-content: flex-start;
        }

        .repo-link {
            max-width: 100%;
        }
    }

    .project-empty-state {
        margin: 0;
        padding: 2rem 1rem;
        color: rgb(var(--gray));
        text-align: center;
        font-weight: 700;
    }

    .project-empty-state[hidden] {
        display: none;
    }

    @media (prefers-reduced-motion: reduce) {
        :global(button[data-project-filter]),
        .project-card,
        .project-title-link,
        .repo-link {
            transition: none;
        }

        :global(button[data-project-filter]:hover),
        :global(button[data-project-filter]:focus-visible),
        .project-card:hover,
        .project-card:focus-within,
        .repo-link:hover {
            transform: none;
        }
    }
</style>
