---
import type { CollectionEntry } from 'astro:content';
import Footer from './Footer.astro';
import Header from './Header.astro';
import FormattedDate from './FormattedDate.astro';
import LocalizedText from './LocalizedText.astro';
import RevealMotion from './RevealMotion.astro';
import { homeContent } from '../data/siteContent';
import { getContentPath, withLocale, type Locale } from '../utils/i18n';

interface Props {
    locale: Locale;
    posts: CollectionEntry<'blog'>[];
}

const { locale, posts } = Astro.props;

const featuredProjectLinkText = {
    zh: '查看详情',
    en: 'View Case Study',
};
---

<Header />

<main>
    <section class="hero card reveal" style="--reveal-delay: 40ms">
        <div class="hero-heading-block reveal" style="--reveal-delay: 100ms">
            {
                locale === 'bi' ? (
                        <>
                            <h1 class="hero-title">{homeContent.title.zh}</h1>
                            <p class="hero-title-en">{homeContent.title.en}</p>
                        </>
                ) : (
                        <LocalizedText locale={locale} text={homeContent.title} tag="h1" class="hero-title" />
                )
            }
        </div>

        <div class="hero-body">
            <div class="hero-copy reveal" style="--reveal-delay: 180ms">
                <LocalizedText locale={locale} text={homeContent.description} tag="p" class="hero-text" />

                <div class="pill-row hero-skills" aria-label={locale === 'en' ? 'Core skills' : '核心技能'}>
                    {
                        homeContent.skills.map((skill) => (
                            <span class="pill">
                                {locale === 'bi'
                                    ? skill.zh === skill.en
                                        ? skill.zh
                                        : `${skill.zh} / ${skill.en}`
                                    : locale === 'zh'
                                        ? skill.zh
                                        : skill.en}
                            </span>
                        ))
                    }
                </div>

                <div class="hero-actions">
                    <a class="button" href={withLocale('/projects', locale)}>
                        <LocalizedText locale={locale} text={homeContent.buttons.projects} tag="span" class="button-label" />
                    </a>
                    <a class="button secondary" href={withLocale('/blog', locale)}>
                        <LocalizedText locale={locale} text={homeContent.buttons.blog} tag="span" class="button-label" />
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="section-block reveal" style="--reveal-delay: 80ms">
        <div class="section-top">
            <LocalizedText locale={locale} text={homeContent.featuredTitle} tag="h2" class="section-heading" />
            <a href={withLocale('/projects', locale)}>
                {locale === 'bi'
                    ? `${homeContent.featuredLink.zh} / ${homeContent.featuredLink.en}`
                    : locale === 'zh'
                        ? homeContent.featuredLink.zh
                        : homeContent.featuredLink.en}
            </a>
        </div>

        <div class="project-grid card featured-project-list">
            {
                homeContent.projects.map((project, index) => {
                    const href = project.slug ? getContentPath('projects', project.slug, locale) : null;

                    const content = (
                        <>
                            <div class="featured-project-head">
                                {
                                    project.status && (
                                        <LocalizedText locale={locale} text={project.status} tag="p" class="project-status-chip" />
                                    )
                                }
                                <LocalizedText locale={locale} text={project.name} tag="h3" class="featured-project-title" />
                                {
                                    project.role && (
                                        <LocalizedText locale={locale} text={project.role} tag="p" class="featured-project-role" />
                                    )
                                }
                            </div>

                            <div class="featured-project-body">
                                <LocalizedText locale={locale} text={project.description} tag="p" class="featured-project-copy" />
                            </div>

                            <div class="featured-project-foot">
                                <div class="pill-row project-stack">
                                    {project.stack.map((item) => <span class="pill">{item}</span>)}
                                </div>

                                {
                                    href && (
                                        <span class="featured-project-link">
                                            {locale === 'bi'
                                                ? `${featuredProjectLinkText.zh} / ${featuredProjectLinkText.en}`
                                                : locale === 'zh'
                                                    ? featuredProjectLinkText.zh
                                                    : featuredProjectLinkText.en}
                                        </span>
                                    )
                                }
                            </div>
                        </>
                    );

                    return href ? (
                        <a class="project-card card motion-card project-card-link reveal" style={`--reveal-delay: ${120 + index * 90}ms`} href={href}>
                            {content}
                        </a>
                    ) : (
                        <article class="project-card card motion-card reveal" style={`--reveal-delay: ${120 + index * 90}ms`}>
                            {content}
                        </article>
                    );
                })
            }
        </div>
    </section>

    <section class="section-block reveal" style="--reveal-delay: 80ms">
        <div class="section-top">
            <LocalizedText locale={locale} text={homeContent.postsTitle} tag="h2" class="section-heading" />
            <a href={withLocale('/blog', locale)}>
                {locale === 'bi'
                    ? `${homeContent.postsLink.zh} / ${homeContent.postsLink.en}`
                    : locale === 'zh'
                        ? homeContent.postsLink.zh
                        : homeContent.postsLink.en}
            </a>
        </div>

        {
            posts.length > 0 ? (
                <div class="post-grid card">
                    {
                        posts.map((post, index) => (
                            <a class="post-card card motion-card reveal" style={`--reveal-delay: ${120 + index * 90}ms`} href={withLocale(`/blog/${post.id}/`, locale)}>
                                <p class="post-date">
                                    <FormattedDate date={post.data.pubDate} />
                                </p>
                                <LocalizedText locale={locale} text={post.data.title} tag="h3" class="post-card-title" />
                                <LocalizedText locale={locale} text={post.data.description} tag="p" class="post-card-description" />
                            </a>
                        ))
                    }
                </div>
            ) : (
                <div class="post-grid card post-empty-card">
                    <p>{locale === 'en' ? 'No posts yet.' : locale === 'zh' ? '暂时还没有文章。' : '暂时还没有文章。 / No posts yet.'}</p>
                </div>
            )
        }
    </section>
</main>

<Footer />
<RevealMotion />

<style>
    .hero {
        position: relative;
        padding: clamp(2rem, 5vw, 4rem) 2rem;
        display: grid;
        gap: 2rem;
        justify-items: center;
        text-align: center;
        overflow: hidden;
    }

    .hero::before {
        content: "";
        position: absolute;
        inset: 1px;
        border-radius: inherit;
        background:
            radial-gradient(circle at 22% 12%, rgba(53, 92, 154, 0.13), transparent 34%),
            radial-gradient(circle at 82% 20%, rgba(120, 154, 198, 0.16), transparent 30%);
        pointer-events: none;
    }

    .hero > * {
        position: relative;
    }

    .hero-heading {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .hero-heading-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        width: min(100%, 60rem);
        margin-bottom: 0.5rem;
    }

    .hero-title {
        max-width: none;
        margin: 0;
        font-size: clamp(2.35rem, 4.4vw, 3.6rem);
        line-height: 1.12;
        letter-spacing: 0;
    }

    .hero-title-en {
        margin: 0;
        font-size: clamp(1.12rem, 2vw, 1.72rem);
        font-weight: 700;
        line-height: 1.2;
        color: rgb(var(--gray-dark));
    }

    .hero-body {
        width: min(100%, 42rem);
        display: grid;
        gap: 0;
        justify-items: center;
    }

    .hero-copy {
        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: none;
    }

    .hero-text {
        max-width: 32rem;
        margin: 0;
        font-size: 1rem;
        color: rgb(var(--gray));
        line-height: 1.8;
    }

    .hero-skills {
        justify-content: center;
        margin-top: 1.35rem;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.9rem;
        margin-top: 1.7rem;
    }

    .button-label {
        line-height: 1.2;
    }

    .section-block {
        margin-top: 4.25rem;
    }

    .section-top {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .project-grid,
    .post-grid {
        display: grid;
        gap: 2rem;
        padding: 1.35rem;
        grid-template-columns: repeat(1,3fr);
        align-items: stretch;
    }

    .featured-project-list {
        grid-template-columns: repeat(1,3fr);
    }

    .project-card,
    .post-card {
        padding: 1.35rem;
    }

    .project-card {
        display: grid;
        grid-template-columns: 1fr;
        grid-template-rows: minmax(1rem, auto) minmax(1rem, auto) 1fr;
        gap: 0;
        min-height: 0;
    }

    .project-card-link {
        color: inherit;
        text-decoration: none;
    }

    .project-card p,
    .post-card p {
        margin-bottom: 0;
        color: rgb(var(--gray));
    }

    :global(.featured-project-title) {
        margin: 0;
        font-size: clamp(1.18rem, 1.45vw, 1.42rem);
        line-height: 1.18;
        letter-spacing: 0;
    }

    :global(.featured-project-title .locale-en) {
        font-size: 0.82em;
        line-height: 1.18;
    }

    .featured-project-copy,
    .project-card :global(p.is-bilingual),
    .project-card p {
        line-height: 1.62;
    }

    .featured-project-head,
    .featured-project-body,
    .featured-project-foot {
        display: flex;
        flex-direction: column;
    }

    .featured-project-head {
        gap: 0.38rem;
        padding-bottom: 0.9rem;
        overflow: hidden;
    }

    .featured-project-body {
        padding-top: 0;
        padding-bottom: 1rem;
        overflow: hidden;
    }

    .featured-project-foot {
        justify-content: flex-start;
        align-self: stretch;
        min-width: 0;
    }

    .project-stack {
        margin-top: 0;
        padding-top: 0;
        justify-content: flex-start;
    }

    :global(.project-status-chip) {
        width: fit-content;
        margin: 0 0 0.1rem;
        padding: 0.28rem 0.55rem;
        border-radius: 999px;
        background: rgba(53, 92, 154, 0.08);
        color: var(--accent-dark);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.04em;
    }

    :global(.project-status-chip .locale-en) {
        font-size: 0.88em;
        opacity: 0.82;
    }

    :global(.featured-project-role) {
        margin: 0;
        color: rgb(var(--gray-dark));
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1.45;
    }

    :global(.featured-project-role .locale-en) {
        display: block;
        margin-top: 0.18rem;
        color: rgb(var(--gray));
        font-size: 0.88em;
        font-weight: 600;
        line-height: 1.4;
    }

    .featured-project-link {
        display: inline-flex;
        margin-top: 1rem;
        color: var(--accent-dark);
        font-size: 0.88rem;
        font-weight: 700;
        justify-content: flex-start;
    }

    .post-card {
        text-decoration: none;
        color: inherit;
    }

    :global(.post-card-title) {
        margin: 0 0 0.65rem;
        font-size: clamp(1.12rem, 1.45vw, 1.32rem);
        line-height: 1.18;
        letter-spacing: 0;
    }

    :global(.post-card-title .locale-en) {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.78em;
        line-height: 1.22;
        color: rgb(var(--gray-dark));
    }

    :global(.post-card-description) {
        margin: 0;
        line-height: 1.62;
    }

    :global(.post-card-description .locale-en) {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.9em;
        line-height: 1.55;
    }

    .post-empty-card {
        color: rgb(var(--gray));
    }

    .post-empty-card p {
        margin: 0;
    }

    .post-date {
        margin-bottom: 0.7rem;
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--accent);
    }

    @media (max-width: 900px) {
        .project-card {
            grid-template-rows: auto auto auto;
        }
    }

    @media (max-width: 900px) {
        .project-grid,
        .post-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
