---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Footer from './Footer.astro';
import FormattedDate from './FormattedDate.astro';
import Header from './Header.astro';
import LocalizedText from './LocalizedText.astro';
import RevealMotion from './RevealMotion.astro';
import type { Locale } from '../utils/i18n';
import { getContentPath } from '../utils/i18n';

interface Props {
    locale: Locale;
    posts: CollectionEntry<'blog'>[];
}

const { locale, posts } = Astro.props;

const pageTitle = {
    zh: '博客',
    en: 'Blog',
};

const pageDescription = {
    zh: '写作记录与文章归档',
    en: 'Writing archive and notes',
};

const emptyText = {
    zh: '暂时还没有文章。',
    en: 'No posts yet.',
};
---

<Header />

<main>
    <section class="page-hero reveal" style="--reveal-delay: 40ms">
        <LocalizedText locale={locale} text={pageTitle} tag="h1" />
        <LocalizedText locale={locale} text={pageDescription} tag="p" class="section-copy" />
    </section>

    <section class="reveal" style="--reveal-delay: 90ms">
        {
            posts.length > 0 ? (
                <div class="post-list card">
                    {
                        posts.map((post, index) => (
                                <article class="card post-card motion-card reveal" style={`--reveal-delay: ${120 + index * 75}ms`}>
                                    <a class="post-card-link" href={getContentPath('blog', post.id, locale)}>
                                        {post.data.heroImage && (
                                                <Image width={720} height={360} src={post.data.heroImage} alt="" />
                                        )}
                                        <LocalizedText locale={locale} text={post.data.title} tag="h2" class="post-card-title" />
                                        <p class="date">
                                            <FormattedDate date={post.data.pubDate} />
                                        </p>
                                        <LocalizedText locale={locale} text={post.data.description} tag="p" class="post-card-description" />
                                    </a>
                                </article>
                        ))
                    }
                </div>
            ) : (
                <div class="card post-list">
                    <LocalizedText locale={locale} text={emptyText} tag="p" class="empty-state" />
                </div>
            )
        }
    </section>
</main>

<Footer locale={locale} />
<RevealMotion />

<style>
    .page-hero {
        margin-top: 1rem;
        margin-bottom: 2rem;
    }

    .post-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.2rem;
        padding: 1.35rem;
        margin-top: 2rem;
    }

    .post-card {
        padding: 1.4rem;
    }

    .post-card-link {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .post-card img {
        display: block;
        width: 100%;
        margin-bottom: 1rem;
        border-radius: 18px;
    }

    :global(.post-card-title) {
        margin: 0 0 0.65rem;
        font-size: clamp(1.26rem, 1.8vw, 1.62rem);
        line-height: 1.2;
        letter-spacing: 0;
        color: rgb(var(--black));
    }

    :global(.post-card-title .locale-en) {
        display: block;
        margin-top: 0.28rem;
        font-size: 0.8em;
        line-height: 1.35;
        color: rgb(var(--gray));
    }

    .date {
        margin: 0 0 0.5rem;
        color: rgb(var(--gray));
        font-size: 0.95rem;
        font-weight: 700;
    }

    :global(.post-card-description) {
        margin: 0;
        color: rgb(var(--gray));
        line-height: 1.7;
    }

    :global(.post-card-description .locale-en) {
        display: block;
        margin-top: 0.28rem;
        font-size: 0.9em;
        line-height: 1.55;
    }

    .empty-state {
        padding: 1.2rem;
        margin: 0;
        color: rgb(var(--gray));
    }
</style>
